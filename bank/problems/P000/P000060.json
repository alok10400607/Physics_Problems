  "stem": "A pendulum is executing simple harmonic motion and its maximum kinetic energy is K<sub>1</sub>. If the length of the pendulum is doubled and it performs simple harmonic motion with the same angular amplitude as in the first case, its maximum kinetic energy is K<sub>2</sub>. Then:",
  "options": {
    "A": "K<sub>2</sub> = $\\frac{K_{1}}{4}$",
    "B": "K<sub>2</sub> = $\\frac{K_{1}}{2}$",
    "C": "K<sub>2</sub> = 2K<sub>1</sub>",
    "D": "K<sub>2</sub> = K<sub>1</sub>"
  },
  "answer": {
    "keys": [
      "C"
    ]
  },
