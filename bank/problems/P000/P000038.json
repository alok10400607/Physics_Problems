  "stem": "Two particles A and B of equal masses are suspended from two massless springs of spring constants $k_{1}$ and $k_{2}$ respectively. If the maximum velocities during oscillations are equal, the ratio of amplitude of A and B is:",
  "options": {
    "A": "$\\frac{k_{2}}{k_{1}}$",
    "B": "$\\frac{k_{1}}{k_{2}}$",
    "C": "$\\sqrt{\\frac{k_{1}}{k_{2}}}$",
    "D": "$\\sqrt{\\frac{k_{2}}{k_{1}}}$"
  },
  "answer": {
    "keys": [
      "D"
    ]
