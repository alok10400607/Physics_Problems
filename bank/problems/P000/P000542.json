  "stem": "A block of mass m slides along a floor while a force of magnitude F is applied to it at an angle θ as shown. The coefficient of kinetic friction is $\\mu_{K}$. Then the blocks acceleration is given by:",
  "options": {
    "A": "$- \\frac{F}{m}\\ \\cos \\theta - \\mu_{K}(g - \\frac{F}{m}\\ \\sin \\theta)$",
    "B": "$\\frac{F}{m}\\ \\cos \\theta - \\mu_{K}(g - \\frac{F}{m}\\ \\sin \\theta)$",
    "C": "$\\frac{F}{m}\\ \\cos \\theta - \\mu_{K}(g + \\frac{F}{m}\\ \\sin \\theta)$",
    "D": "$\\frac{F}{m}\\ \\cos \\theta + \\mu_{K}(g - \\frac{F}{m}\\ \\sin \\theta)$"
  },
  "answer": {
    "keys": [
      "B"
    ]
