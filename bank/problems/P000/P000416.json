    "A": "$\\frac{1}{2}ML\\omega^{2}$",
    "B": "$\\frac{1}{2}ML^{2}\\omega$",
    "C": "$ML\\omega^{2}$",
    "D": "$\\frac{1}{2}ML^{2}\\omega^{2}$"
  },
