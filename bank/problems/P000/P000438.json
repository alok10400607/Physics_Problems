  "stem": "A car is negotiating a curved road of radius R. The road is banked at an angle θ. the coefficient of friction between the tyres of the car and the road is $\\mu_{s}$. The maximum safe velocity on this road is:",
  "options": {
    "A": "$\\sqrt{gR^{2}\\frac{\\mu_{s} + \\tan \\theta}{1 - \\mu_{s}\\tan \\theta}}$",
    "B": "$\\sqrt{gR\\frac{\\mu_{s} + \\tan \\theta}{1 - \\mu_{s}\\tan \\theta}}$",
    "C": "$\\sqrt{\\frac{g}{R}\\frac{\\mu_{s} + \\tan \\theta}{1 - \\mu_{s}\\tan \\theta}}$",
    "D": "$\\sqrt{(g{/R}^{2})\\frac{\\mu_{s} + \\tan \\theta}{1 - \\mu_{s}\\tan \\theta}}$"
  },
  "answer": {
    "keys": [
      "B"
    ]
  },
